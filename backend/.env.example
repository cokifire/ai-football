DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=football

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=
# key 的滚动窗口限额（免费套餐 10 次/分钟）；节流间隔 = 窗口/(额度-1) ≈ 6.7s
API_FOOTBALL_RATE_LIMIT=10
API_FOOTBALL_RATE_WINDOW=60

# 天气数据（OpenWeatherMap）
OPENWEATHERMAP_API_KEY=

# 外部比赛情报（Firecrawl）
FIRECRAWL_API_KEY=
# 本地 Docker Firecrawl API 地址（默认端口通常为 3002）
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
# Firecrawl 托管套餐月度配额重置日（每月几号，1-28，UTC 日期，默认 22）。额度不是
# 按天发放：标记耗尽后闩锁会一直撑到当月这个日子才自动放行，避免每天放行一次反复
# 重试到再次耗尽。这个日子随续费/购买额度变动 —— 跑
# python tools/check_firecrawl_quota.py 看到真实账期后，按需修改这里。
FIRECRAWL_QUOTA_RESET_DAY=22

# ── Firecrawl 代理通道（主额度耗尽时经这里 + 备用 key 抓情报）──
# 三项都留空 = 不启用，主额度耗尽后按原来的行为快速失败；
# 任一非空即启用代理通道，未填的项沿用主配置。
# FIRECRAWL_PROXY         HTTP 代理，形如 http://username:password@ip:port
#                         （SDK 的 requests 调用不接受 proxies 参数，代理路径
#                           改走自带适配器直连 REST 端点，不动进程环境变量）
# FIRECRAWL_PROXY_BASE_URL  代理要访问的 firecrawl 端点（留空 = 沿用上面主端点）
# FIRECRAWL_PROXY_API_KEY   备用 API key（留空 = 沿用主 key）
FIRECRAWL_PROXY=
FIRECRAWL_PROXY_BASE_URL=
FIRECRAWL_PROXY_API_KEY=
# 备用账号的月度配额重置日（与主账号分开配：实测主账号 11-22、备用账号 11-09，
# 两个账期不同，共用一个日子会让备用通道白等或早放行）
FIRECRAWL_PROXY_QUOTA_RESET_DAY=9

# ── 大模型经 codex CLI 调用（不再 HTTP 直连 /chat/completions）──
# *_MODEL：codex exec 的 -m 模型名，须为 codex/provider 支持的模型
# *_BASE_URL：非空时用 -c 覆盖 ~/.codex/config.toml 的 model_providers；空=沿用服务器 codex 配置
# *_API_KEY：只通过环境变量注入 codex 子进程（变量名 CODEX_API_KEY_ENV），不进命令行
INTELLIGENCE_LLM_API_KEY=
INTELLIGENCE_LLM_BASE_URL=
INTELLIGENCE_LLM_MODEL=

PREDICTION_LLM_API_KEY=
PREDICTION_LLM_BASE_URL=
PREDICTION_LLM_MODEL=
# 为 true 时，预测直接使用 codex 自身配置的默认模型（~/.codex/config.toml），
# 忽略 PREDICTION_LLM_* 与 PREDICTION_FALLBACK_LLM_* 全部配置
PREDICTION_USE_CODEX_DEFAULT=false

# 备用预测模型（可独立配置 url/key/model；若 url/key 留空则沿用主模型）
PREDICTION_FALLBACK_LLM_MODEL=
PREDICTION_FALLBACK_LLM_BASE_URL=
PREDICTION_FALLBACK_LLM_API_KEY=

# ── codex CLI 执行环境 ──
CODEX_BIN=codex
# CODEX_HOME（空=继承环境，默认 ~/.codex；须已完成登录且 skill 已部署）
CODEX_HOME=
# 沙箱模式：预测要跑 football-bayes skill 的脚本，不能用 read-only
CODEX_SANDBOX=workspace-write
# 单场预测 / 情报整理（含重试）总墙钟秒数
CODEX_TIMEOUT_PREDICT=1200
CODEX_TIMEOUT_INTELLIGENCE=1200
# 失败仅对 codex 自身重试次数（不回退 HTTP）
CODEX_RETRIES=2
# prompt 中以 $<name> 触发的 skill（部署在 ~/.codex/skills/<name>/）
CODEX_SKILL_NAME=football-bayes
# base_url 非空时 -c 覆盖用的 provider id；注入 api_key 的环境变量名
# 重要：CODEX_API_KEY_ENV 必须与 ~/.codex/config.toml 中该 provider 的 env_key 一致
# （[model_providers.x] env_key = "CODEX_API_KEY"），否则注入的 key 不会被读取，
# 表现为 codex 报 401 Invalid proxy API key。
CODEX_PROVIDER_ID=codex_env
CODEX_API_KEY_ENV=CODEX_API_KEY
# 允许联网（skill 的 S7 外部交叉验证需要）
CODEX_NETWORK=true

CACHE_TTL=3600

# API 认证（至少 32 字节随机值；ADMIN_API_KEY 不可与 READ_API_KEY 相同）
READ_API_KEY=
ADMIN_API_KEY=
