DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=football

API_FOOTBALL_KEY=
# 备用 key: 主 key 额度耗尽时, 统一 client 自动切换到此 key 重试. 留空则不启用备用.
API_FOOTBALL_KEY_BACKUP=
API_FOOTBALL_BASE_URL=

# 天气数据（OpenWeatherMap）
OPENWEATHERMAP_API_KEY=

# 外部比赛情报（Firecrawl）
FIRECRAWL_API_KEY=

# 情报整理 LLM（OpenAI-compatible）
INTELLIGENCE_LLM_API_KEY=
INTELLIGENCE_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
INTELLIGENCE_LLM_MODEL=agnes-2.5-flash

# 主预测 LLM（OpenAI-compatible）
PREDICTION_LLM_API_KEY=
PREDICTION_LLM_BASE_URL=https://api.deepseek.com/v1
PREDICTION_LLM_MODEL=deepseek-chat

# 备用预测 LLM（主模型请求失败或返回字段不完整时使用，可选）
PREDICTION_FALLBACK_LLM_API_KEY=
PREDICTION_FALLBACK_LLM_BASE_URL=
PREDICTION_FALLBACK_LLM_MODEL=

CACHE_TTL=3600

# API 认证（至少 32 字节随机值；ADMIN_API_KEY 不可与 READ_API_KEY 相同）
READ_API_KEY=
ADMIN_API_KEY=
